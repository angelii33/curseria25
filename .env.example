# Variables para Vercel (Settings → Environment Variables). Nunca subas los valores reales.

# ── Sitio ──
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://ppcjjmejawxjlfblbudt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. La usan el aviso de Mercado Pago y el límite de la IA.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago (solo servidor) ──
# Access token de producción: Tus integraciones → Credenciales de producción.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → Webhooks). URL del aviso:
#   https://tu-dominio.com/api/pagos/mercadopago
# Eventos: Pagos, Planes y suscripciones.
MP_WEBHOOK_SECRET=

# ── Datos legales y de contacto (públicos: aparecen en la página) ──
NEXT_PUBLIC_LEGAL_RESPONSABLE=
NEXT_PUBLIC_LEGAL_DOMICILIO=
NEXT_PUBLIC_CONTACTO_CORREO=
NEXT_PUBLIC_CONTACTO_WHATSAPP=

# ── Opcional: revisión del cuaderno con IA (solo servidor) ──
ANTHROPIC_API_KEY=
